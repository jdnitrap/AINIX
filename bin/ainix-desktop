#!/usr/bin/env bash
# Opens the AINIX window. The helper stays inside nix-shell.
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
launcher="${XDG_DATA_HOME:-$HOME/.local/share}/applications/ainix.desktop"
mkdir -p "$(dirname "$launcher")"
cat > "$launcher" <<EOF
[Desktop Entry]
Name=AINIX
GenericName=NixOS helper
Comment=Ask Nix and NixOS questions without a terminal
Exec=$root/bin/ainix-desktop
Icon=preferences-system
Terminal=false
Type=Application
Categories=Development;Utility;
Keywords=nix;nixos;ainix;
StartupNotify=true
StartupWMClass=org.jdnitrap.Ainix
EOF
cd "$root"
if [ -x /run/current-system/sw/bin/nix-shell ]; then
  nix_shell=/run/current-system/sw/bin/nix-shell
else
  nix_shell=$(command -v nix-shell)
fi
exec "$nix_shell" "$root/gui-shell.nix" --run 'python3 -m ainix_gui'
